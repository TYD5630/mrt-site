---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import Comments from '../../components/Comments.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: any;
}

const { post } = Astro.props as Props;
const { Content } = await render(post);

// Reading time: ~200 words per minute for Chinese/English mix
const wordCount = (post.body || '').length;
const readTime = Math.max(1, Math.ceil(wordCount / 400));

// Previous & next posts
const allPosts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const idx = allPosts.findIndex(p => p.id === post.id);
const prevPost = idx < allPosts.length - 1 ? allPosts[idx + 1] : null;
const nextPost = idx > 0 ? allPosts[idx - 1] : null;
---

<BlogLayout title={post.data.title} description={post.data.description}>
  <article>
    <div class="flex flex-wrap items-center gap-3 text-sm mb-6" style="color: var(--color-muted);">
      <time>
        {post.data.pubDate.toLocaleDateString('zh-CN', {
          year: 'numeric', month: 'long', day: 'numeric',
        })}
      </time>
      <span>·</span>
      <span>约 {readTime} 分钟</span>
      <span>·</span>
      <span>{wordCount.toLocaleString()} 字</span>
    </div>

    <h1 class="text-3xl font-bold">{post.data.title}</h1>

    {post.data.tags?.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-4 mb-8">
        {post.data.tags.map((tag: string) => (
          <a href={`/blog/tags/${encodeURIComponent(tag)}/`} class="tag" style="text-decoration: none;">{tag}</a>
        ))}
      </div>
    )}

    <div class="prose mt-8">
      <Content />
    </div>

    <!-- Prev / Next navigation -->
    <nav class="flex justify-between items-stretch gap-4 mt-16 pt-8" style="border-top: 1px solid var(--color-border);">
      {prevPost ? (
        <a href={`/blog/${prevPost.id}/`} class="flex-1 group p-4 rounded-xl border transition-all" style="border-color: var(--color-border); background: var(--color-surface); text-decoration: none;" hover-style="border-color: var(--color-accent);">
          <div class="text-xs mb-1" style="color: var(--color-muted);">← 上一篇</div>
          <div class="text-sm font-medium group-hover" style="color: var(--color-text);">{prevPost.data.title}</div>
        </a>
      ) : <div class="flex-1"></div>}
      {nextPost ? (
        <a href={`/blog/${nextPost.id}/`} class="flex-1 group p-4 rounded-xl border text-right transition-all" style="border-color: var(--color-border); background: var(--color-surface); text-decoration: none;" hover-style="border-color: var(--color-accent);">
          <div class="text-xs mb-1" style="color: var(--color-muted);">下一篇 →</div>
          <div class="text-sm font-medium" style="color: var(--color-text);">{nextPost.data.title}</div>
        </a>
      ) : <div class="flex-1"></div>}
    </nav>

    <Comments />
  </article>
</BlogLayout>
