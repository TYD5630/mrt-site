---
/**
 * Giscus 评论区组件
 * 基于 GitHub Discussions，免费无广告。
 *
 * 启用步骤：
 * 1. 在 GitHub 仓库启用 Discussions（Settings → General → Discussions ✓）
 * 2. 安装 Giscus App：https://github.com/apps/giscus
 * 3. 到这里生成配置：https://giscus.app/zh-CN
 * 4. 将生成的 data-* 参数填入下方
 */

// ─── 配置区 ───
// 去 https://giscus.app/zh-CN 生成你的配置后替换这里
const GISCUS_CONFIG = {
  repo: 'TYD5630/mrt-site',            // GitHub 仓库
  repoId: 'R_kgDOSZ7gmQ',               // 仓库 ID
  category: 'General',                   // Discussions 分类
  categoryId: 'DIC_kwDOSZ7gmc4C8wdc',   // 分类 ID
  mapping: 'pathname',                   // 页面与 discussion 的映射方式
  strict: '1',
  reactionsEnabled: '1',
  emitMetadata: '0',
  inputPosition: 'top',
  lang: 'zh-CN',                         // 中文界面
};
// ──────────

const { repo, repoId, category, categoryId, mapping, strict, reactionsEnabled, emitMetadata, inputPosition, lang } = GISCUS_CONFIG;
const ready = repoId && categoryId;
---

{ready ? (
  <div class="mt-16 pt-8 border-t" style="border-color: var(--color-border);">
    <h2 class="text-lg font-semibold mb-6">评论</h2>
    <div id="giscus-comments"></div>
  </div>
) : (
  <div class="mt-16 pt-8 border-t" style="border-color: var(--color-border);">
    <h2 class="text-lg font-semibold mb-4">评论</h2>
    <div class="p-6 rounded-xl border text-sm" style="background: var(--color-surface); border-color: var(--color-border); color: var(--color-muted);">
      <p>评论区待配置 🙌</p>
      <p class="mt-2">在 <code style="font-size:0.875em; background:var(--color-code-bg); padding:0.1em 0.3em; border-radius:3px;">src/components/Comments.astro</code> 中填入 Giscus 参数即可启用。</p>
    </div>
  </div>
)}

{ready && (
  <script is:inline>
    (function() {
      const script = document.createElement('script');
      script.src = 'https://giscus.app/client.js';
      script.setAttribute('data-repo', '{repo}');
      script.setAttribute('data-repo-id', '{repoId}');
      script.setAttribute('data-category', '{category}');
      script.setAttribute('data-category-id', '{categoryId}');
      script.setAttribute('data-mapping', '{mapping}');
      script.setAttribute('data-strict', '{strict}');
      script.setAttribute('data-reactions-enabled', '{reactionsEnabled}');
      script.setAttribute('data-emit-metadata', '{emitMetadata}');
      script.setAttribute('data-input-position', '{inputPosition}');
      script.setAttribute('data-lang', '{lang}');
      script.setAttribute('data-loading', 'lazy');
      script.setAttribute('crossorigin', 'anonymous');
      script.async = true;
      document.getElementById('giscus-comments').appendChild(script);
    })();
  </script>
)}
