---
export interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
---

{headings.length > 1 && (
  <nav class="sticky top-20 space-y-1">
    <h4 class="text-xs font-semibold uppercase tracking-wider mb-3" style="color: var(--color-muted);">目录</h4>
    {headings.filter(h => h.depth <= 3).map(h => (
      <a
        href={`#${h.slug}`}
        class={`toc-link toc-h${h.depth}`}
      >
        {h.text}
      </a>
    ))}
  </nav>
)}
