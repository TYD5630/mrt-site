---
export interface Props {
  title: string;
  description: string;
  url: string;
  index: number;
  tags?: string[];
}

const { title, description, url, index, tags = [] } = Astro.props;
---

<a href={url} class="card-hover block p-5 rounded-xl border" style="background: var(--color-surface); border-color: var(--color-border);">
  <span class="text-xs" style="color: var(--color-muted);">{(index + 1).toString().padStart(2, '0')}</span>
  <h2 class="text-lg font-semibold mt-1 title-link">{title}</h2>
  <p class="text-sm mt-2" style="color: var(--color-muted);">{description}</p>
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mt-3">
      {tags.slice(0, 3).map(tag => (
        <span class="tag">{tag}</span>
      ))}
    </div>
  )}
</a>
